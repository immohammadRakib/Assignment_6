model Feeder {
  id           String      @id @default(uuid(7))
  name         String      
  
  substationId String
  substation   Substation  @relation(fields: [substationId], references: [id], onDelete: Cascade)

  areas        Area[]

  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("feeders")
}
