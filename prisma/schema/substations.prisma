model Substation {
  id           String         @id @default(uuid(7))
  name         String         
  capacity     String        
  
  zoneId       String
  zone         DistributionZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  feeders      Feeder[]
  
  operators    PowerOperator[] 

  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("substations")
}
